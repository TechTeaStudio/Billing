<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574</NoWarn>
    <PackageId>TechTeaStudio.Billing</PackageId>
    <Version>0.3.0</Version>
    <Authors>Ronald Ryan</Authors>
    <Company>Tech Tea Studio</Company>
    <Description>Provider-agnostic payment billing for ASP.NET Core. Hosted checkout and verified webhooks for Stripe, YooKassa, Shopify and Telegram Stars, plus external donation platforms (Ko-fi, Patreon, manual Boosty) with claim-code attribution and an unclaimed-purchase holding area - all behind one IBillingProvider seam with pluggable payment store and fulfillment.</Description>
    <RepositoryUrl>https://github.com/TechTeaStudio/Billing</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TechTeaStudio/Billing</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) Tech Tea Studio 2026</Copyright>
    <PackageReleaseNotes>v0.3.0: External purchase support - Ko-fi and Patreon webhook providers (verified byte-exact against official specs), claim-code attribution with identity links and an unclaimed holding area, manual submission path for Boosty, refund recording (PaymentRefunded/Refunded), BillingPlanGuard moved into the package, new package icon.</PackageReleaseNotes>
    <PackageTags>billing;payments;stripe;yookassa;shopify;telegram;kofi;patreon;boosty;donations;checkout;webhook;aspnetcore;TechTeaStudio</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
