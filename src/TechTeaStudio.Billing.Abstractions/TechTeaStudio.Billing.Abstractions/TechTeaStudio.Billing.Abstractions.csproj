<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contracts only. This project deliberately has ZERO package references and no
       FrameworkReference: a host's domain assembly can implement IBillingFulfillment or
       IBillingPaymentStore without being dragged onto the ASP.NET Core shared framework,
       which is exactly what referencing the main package would do to it. -->

  <PropertyGroup>
    <!-- Wider than the solution-wide set: this project has no ASP.NET Core dependency, so it can
         also serve .NET Framework 4.6.2+ (netstandard2.0) and .NET Framework 4.7.2 directly.
         The main TechTeaStudio.Billing package cannot follow - it needs the ASP.NET Core shared
         framework, which has not run on .NET Framework since ASP.NET Core 3.0. -->
    <TargetFrameworks>netstandard2.0;net472;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>TechTeaStudio.Billing.Abstractions</PackageId>
    <!-- Must be a literal tag in this file - the publish workflow greps for it. Keep in sync
         with TechTeaStudio.Billing.csproj; see the note in Directory.Build.props. -->
    <Version>0.5.1</Version>
    <Description>Contracts for TechTeaStudio.Billing: IBillingProvider, IBillingService, IBillingPaymentStore, IBillingFulfillment, IExternalPurchaseService, the attribution stores, the payment/notification models, ClaimCode and BillingPlanGuard. No dependencies and no ASP.NET Core framework reference, so domain and application assemblies can implement the seams without taking on the web stack. Referenced automatically by TechTeaStudio.Billing.</Description>
    <PackageTags>billing;payments;abstractions;contracts;netstandard;netframework;stripe;yookassa;shopify;telegram;kofi;patreon;TechTeaStudio</PackageTags>
    <PackageReleaseNotes>v0.5.0: First standalone release. Split out of TechTeaStudio.Billing so implementing the host seams no longer requires the ASP.NET Core shared framework. Targets netstandard2.0 and net472 alongside net5.0 through net10.0, so a .NET Framework 4.6.2+ assembly can share these contracts with a modern billing host. Namespaces are unchanged (TechTeaStudio.Billing.Abstractions, TechTeaStudio.Billing), so existing code needs no edits. Note that on netstandard2.0/net472 the two default-implemented members of IBillingPaymentStore must be implemented, because those runtimes have no default interface members.

Full changelog: https://github.com/TechTeaStudio/Billing/blob/product/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- CI builds on ubuntu-latest, where the .NET Framework reference assemblies do not exist
         and the net472 leg would fail with MSB3644. This package supplies them from NuGet.
         PrivateAssets="all" keeps it a build-time-only input: it does NOT appear as a package
         dependency, so TechTeaStudio.Billing.Abstractions still ships with none. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
